{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console",
              "Args": {
                "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Literate, Serilog.Sinks.Console",
                "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}{NewLine}{Message:lj} {Properties:j}{NewLine}{Exception}{NewLine}"
              }
            }
          ]
        }
      }
    ]
  },
  "OpenTelemetry": {
    "EndpointTracing": "http://10.0.0.195:14317"
  },
  "Database": {
    "ConnectionString": "Host=10.0.0.195;Port=5435;Database=ntt_bank;Username=postgres;Password=localP@ssword;Search Path=rag_schema, public"
  },
  "Embedding": {
    "Provider": "Ollama",
    "Model": "all-minilm",
    "Endpoint": "http://localhost:11434",
    "MaxDistance": 0.85
  }
}
